# LearnSphere AI — Backend Production Environment Configuration

# Application Environment
ENVIRONMENT=production

# Server Port (assigned by host platform like Render, Railway, Fly.io)
PORT=8000

# Strong Cryptographic Secret for RFC 7519 HS256 JWT tokens
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-in-production

# JWT Token Expiration in Hours
TOKEN_EXPIRE_HOURS=72

# Allowed CORS Origins (comma-separated list of deployed frontend URLs)
CORS_ORIGINS=https://learnsphere-ai.vercel.app,https://learnsphere.yourdomain.com

# Database Connection (Persistent disk path for SQLite or external PostgreSQL URL)
# For SQLite on persistent disk: sqlite:////var/data/learnsphere_cse.db
# For PostgreSQL: postgresql://user:password@hostname:5432/learnsphere_db
DATABASE_URL=sqlite:///./learnsphere_cse.db

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_MINUTE=45

# Google Gemini AI API Key (Server-side only — never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here
